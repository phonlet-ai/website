# Set only when the public deployment has a real origin.
# SITE_URL=https://your-domain.example

# Address the contact form's "Open in email app" button writes to. Without it the form
# only offers download and copy.
# CONTACT_EMAIL=hello@your-domain.example

# No credentials are needed: Phonlet Wake runs entirely in the browser.

# The public Phonlet Wake repository; the docs link its latest release once it is set.
# REPO_URL=https://github.com/your-org/wake
